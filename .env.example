# Server-only. Paste your OpenRouter key after the = sign.
OPENROUTER_API_KEY=
# Optional: provider/model ID. Blank uses your OpenRouter account default.
# Choose a model/provider supporting images and tools, e.g. openai/gpt-4.1-mini.
OPENROUTER_MODEL=

# Optional for reasoning models; Gemini 3 Flash supports low for interactive use.
OPENROUTER_REASONING_EFFORT=
